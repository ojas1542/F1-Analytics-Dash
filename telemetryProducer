import json
import time
from collections import deque
from datetime import datetime, timezone
from kafka import KafkaProducer
from telemetryIngester import OpenF1Client

class TieredRateLimiter:
    """
    Handles endpoint-specific polling frequencies while respecting global limits.
    """
    def __init__(self, global_max_sec: int = 6, global_max_min: int = 60):
        self.global_max_sec = global_max_sec
        self.global_max_min = global_max_min
        
        self.sec_timestamps = deque()
        self.min_timestamps = deque()
        
        # Track last query execution timestamp per request type
        self.last_execution = {}

    def is_type_due(self, request_type: str, interval_seconds: float) -> bool:
        """Checks if enough time has elapsed since the last request of this type."""
        now = time.time()
        last_time = self.last_execution.get(request_type, 0)
        return (now - last_time) >= interval_seconds

    def wait_and_record(self, request_type: str):
        """Enforces global limits before executing a request."""
        now = time.time()
        
        # Purge old timestamps
        while self.sec_timestamps and self.sec_timestamps[0] <= now - 1.0:
            self.sec_timestamps.popleft()
        while self.min_timestamps and self.min_timestamps[0] <= now - 60.0:
            self.min_timestamps.popleft()

        sleep_needed = 0.0

        if len(self.min_timestamps) >= self.global_max_min:
            sleep_needed = max(sleep_needed, self.min_timestamps[0] + 60.0 - now)

        if len(self.sec_timestamps) >= self.global_max_sec:
            sleep_needed = max(sleep_needed, self.sec_timestamps[0] + 1.0 - now)

        if sleep_needed > 0:
            print(f"[GLOBAL LIMIT] Sleeping {sleep_needed:.2f}s...")
            time.sleep(sleep_needed)
            return self.wait_and_record(request_type)

        # Record timestamp for global and specific request type
        current_time = time.time()
        self.sec_timestamps.append(current_time)
        self.min_timestamps.append(current_time)
        self.last_execution[request_type] = current_time


# Kafka Producer Initialization
producer = KafkaProducer(
    bootstrap_servers=['localhost:9092'],
    value_serializer=lambda v: json.dumps(v).encode('utf-8'),
    key_serializer=lambda k: str(k).encode('utf-8') if k else None,
    acks='all'
)

def send_event(topic, key, payload):
    producer.send(topic, key=key, value=payload)

# Initialize Tiered Limiter
limiter = TieredRateLimiter(global_max_sec=6, global_max_min=60)

print("Starting Tiered Telemetry Producer...\n")

try:
    client = OpenF1Client()
    
    # Session setup (Only run once at startup)
    sessions = client.get_sessions(year=2026, country_name="Netherlands", session_name="Race")
    if not sessions:
        raise ValueError("No session found for specified parameters.")
    curr_sesh = sessions[0]["session_key"]

    while True:
        # 1. Car Telemetry (High Priority: Poll every 1.5s -> ~40 API calls/min)
        if limiter.is_type_due("car_data", interval_seconds=1.5):
            limiter.wait_and_record("car_data")
            
            # 1 API Request gets all cars at once
            res = client.get_car_data(session_key=curr_sesh)
            for item in res:
                driver_no = item.get('driver_number')
                send_event('car_data', key=driver_no, payload=item)
            print(f"[{datetime.now().strftime('%H:%M:%S')}] Polled: car_data ({len(res)} items)")

        # 2. Lap Telemetry (Medium Priority: Poll every 15s -> 4 API calls/min)
        if limiter.is_type_due("laps", interval_seconds=15.0):
            limiter.wait_and_record("laps")
            
            # 1 API Request gets all lap data
            res = client.get_laps(session_key=curr_sesh)
            for item in res:
                driver_no = item.get('driver_number')
                send_event('laps', key=driver_no, payload=item)
            print(f"[{datetime.now().strftime('%H:%M:%S')}] Polled: laps ({len(res)} items)")

        # 3. Pit Telemetry (Medium Priority: Poll every 20s -> 3 API calls/min)
        if limiter.is_type_due("pit", interval_seconds=20.0):
            limiter.wait_and_record("pit")
            
            # 1 API Request gets all pit stops
            res = client.get_pit(session_key=curr_sesh)
            for item in res:
                driver_no = item.get('driver_number')
                send_event('pit', key=driver_no, payload=item)
            print(f"[{datetime.now().strftime('%H:%M:%S')}] Polled: pit ({len(res)} items)")

        # 4. Race Control (Low Priority: Poll every 30s -> 2 API calls/min)
        if limiter.is_type_due("race_control", interval_seconds=30.0):
            limiter.wait_and_record("race_control")
            
            # 1 API Request gets all race control events
            res = client.get_race_control(session_key=curr_sesh)
            for item in res:
                send_event('race_control', key='GLOBAL', payload=item)
            print(f"[{datetime.now().strftime('%H:%M:%S')}] Polled: race_control ({len(res)} items)")

        # Small sleep step to prevent CPU spinning
        time.sleep(0.1)

except KeyboardInterrupt:
    print("\nStopping producer...")
finally:
    producer.flush()
    producer.close()
    print("Producer successfully closed.")