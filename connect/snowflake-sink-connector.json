{
  "connector.class": "com.snowflake.kafka.connector.SnowflakeStreamingSinkConnector",
  "tasks.max": "1",

  "topics": "car_data,laps,pit,race_control",

  "snowflake.url.name": "${SNOWFLAKE_ACCOUNT}.snowflakecomputing.com:443",
  "snowflake.user.name": "${SNOWFLAKE_USER}",
  "snowflake.private.key": "${SNOWFLAKE_PRIVATE_KEY_INLINE}",
  "snowflake.private.key.passphrase": "${SNOWFLAKE_PRIVATE_KEY_PASSPHRASE}",
  "snowflake.database.name": "${SNOWFLAKE_DATABASE}",
  "snowflake.schema.name": "${SNOWFLAKE_SCHEMA}",
  "snowflake.role.name": "${SNOWFLAKE_ROLE}",

  "snowflake.streaming.validate.compatibility.with.classic": "false",
  "snowflake.enable.schematization": "false",

  "snowflake.topic2table.map": "car_data:raw_car_telemetry,race_control:raw_race_control,laps:raw_lap_data,pit:raw_pit_stops",

  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false"
}
