# Copy to .env and fill in. docker-compose reads this automatically and
# passes these through to the airflow-webserver/airflow-scheduler containers.
#
# OpenF1 batch landing is local disk for now (./data/raw, mounted into the
# containers at /opt/airflow/data/raw) -- no cloud storage needed.

# -- Snowflake (loading + dbt) --
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_DATABASE=F1_ANALYTICS
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ANALYTICS_SCHEMA=ANALYTICS
SNOWFLAKE_WAREHOUSE=F1_WH

# Auth: either key-pair (preferred) or password.
# For key-pair: drop the .p8 file at ./secrets/snowflake_key.p8 on the host
# (docker-compose mounts ./secrets read-only into the airflow containers at
# /opt/airflow/secrets) and set the path below to the in-container location.
SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/secrets/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_PASSWORD=

# -- Airflow webserver login --
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
